# RecoverAI Master Environment Configuration Example
# Copy this file to server/.env and fill in your local credentials

# Option 1: Standard Individual Variables (Default Local Dev)
DB_USER=postgres
DB_HOST=localhost
DB_NAME=recoverai
DB_PASSWORD=your_secure_password_here
DB_PORT=8469
DB_SSL=false

# Option 2: Cloud Managed Connection String (e.g. Neon, Supabase, Render, AWS RDS)
# DATABASE_URL=postgresql://postgres:your_password@ep-host.region.aws.neon.tech/recoverai?sslmode=require

# Express Server Configuration
PORT=5000
NODE_ENV=development
